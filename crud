    <?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:h="jakarta.faces.html"
      xmlns:f="jakarta.faces.core">

<h:head>
    <title>Employee Form</title>
</h:head>

<h:body>
    <h2>
        <h:outputText
                value="#{employeeBean.editMode
                    ? 'Update Employee'
                    : 'Register New Employee'}"/>
    </h2>
    <!-- ================= FORM ================= -->
    <h:form id="empForm">

        <h:inputHidden value="#{employeeBean.empid}" />

        Name<br/>
        <h:inputText value="#{employeeBean.name}" /><br/><br/>

        Email<br/>
        <h:inputText value="#{employeeBean.email}" /><br/><br/>

        Designation<br/>
        <h:inputText value="#{employeeBean.designation}" /><br/><br/>

        Department<br/>
        <h:inputText value="#{employeeBean.department}" /><br/><br/>

        Salary<br/>
        <h:inputText value="#{employeeBean.salary}">
            <f:convertNumber />
        </h:inputText><br/><br/>

        Hire Date<br/>
        <h:inputText value="#{employeeBean.hireDate}" type="date">
            <f:convertDateTime pattern="yyyy-MM-dd"/>
        </h:inputText><br/><br/>

        <h:commandButton value="Submit"
                         action="#{employeeBean.addEmployee}"
                         rendered="#{!employeeBean.editMode}" />

        <h:commandButton value="Update"
                         action="#{employeeBean.updateEmployee}"
                         rendered="#{employeeBean.editMode}" />

    </h:form>


    <hr/>

    <!-- ================= DATA TABLE ================= -->
    <h:form id="tableForm">

        <h:dataTable value="#{employeeBean.allEmployees}" var="emp"
                     border="1" cellpadding="5">

            <h:column>
                <f:facet name="header">Name</f:facet>
                #{emp.name}
            </h:column>

            <h:column>
                <f:facet name="header">Email</f:facet>
                #{emp.email}
            </h:column>

            <h:column>
                <f:facet name="header">Designation</f:facet>
                #{emp.designation}
            </h:column>

            <h:column>
                <f:facet name="header">Department</f:facet>
                #{emp.department}
            </h:column>

            <h:column>
                <f:facet name="header">Salary</f:facet>
                #{emp.salary}
            </h:column>

            <h:column>
                <f:facet name="header">Hire Date</f:facet>
                <h:outputText value="#{emp.hireDate}">
                    <f:convertDateTime pattern="yyyy-MM-dd"/>
                </h:outputText>
            </h:column>

            <h:column>
                <f:facet name="header">Actions</f:facet>

                <!-- EDIT -->
                <h:commandLink value="Edit"
                               action="#{employeeBean.editEmployee(emp)}" />

                &nbsp;|&nbsp;

                <!-- DELETE -->
                <h:commandLink value="Delete"
                               action="#{employeeBean.deleteEmployee(emp)}"
                               onclick="return confirm('Are you sure?');" />
            </h:column>

        </h:dataTable>

    </h:form>


</h:body>
</html>
      
